{
  "include": [
    "backend/src",
    "backend/tests",
    "backend/scripts"
  ],
  "exclude": [
    "**/__pycache__",
    "**/*.egg-info",
    "frontend/node_modules",
    "frontend/dist",
    "frontend/.angular"
  ],
  "extraPaths": [
    "backend/src"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
